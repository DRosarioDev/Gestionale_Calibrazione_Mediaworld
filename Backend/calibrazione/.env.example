# =====================================================================
# Variabili d'ambiente per lo sviluppo locale con PostgreSQL
# =====================================================================
# Copiare questo file in ".env" (ignorato da Git) e adattare i valori.
#
# - "docker compose up -d" legge automaticamente il file ".env" che si
#   trova nella stessa cartella del docker-compose.yml.
# - Spring Boot NON legge ".env": le stesse variabili vanno esportate
#   nella shell oppure configurate nella IDE.
# =====================================================================

# --------------------- Container PostgreSQL --------------------------
POSTGRES_DB=calibrazione
POSTGRES_USER=calibrazione
POSTGRES_PASSWORD=calibrazione
POSTGRES_PORT=5432
TZ=Europe/Rome

# --------------------- Applicazione Spring Boot ---------------------
SPRING_PROFILES_ACTIVE=postgres

DB_URL=jdbc:postgresql://localhost:5432/calibrazione
DB_USER=calibrazione
DB_PASSWORD=calibrazione

# Almeno 32 caratteri, diversa da quella di sviluppo.
JWT_SECRET=chiave-di-sviluppo-da-sostituire-4f8a2c9e7b1d6350

# Primo avvio: crea l'amministratore con password cifrata a runtime.
APP_SEED_ADMIN=true
APP_ADMIN_EMAIL=admin@media-saturn.com
APP_ADMIN_PASSWORD=Admin123!
APP_ADMIN_NOME=Marco
APP_ADMIN_COGNOME=Rossi

# Dati dimostrativi (5 utenti e 20 TV). Lasciare false in produzione.
APP_SEED_DEMO=false
